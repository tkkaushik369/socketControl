{
	"compilerOptions": {
		"jsx": "react-jsx",
		// "target": "ES2022",
		"target": "ES6",
		"module": "commonjs",
		"rootDir": "../../",
		"outDir": "../../dist/server",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": true,
		// "declarationMap": false,
		"declarationDir": "../../types/server",
		"paths": {
			"@World": [
				"../world/ts/World.ts"
			],
			"@WorkerBase": [
				"../world/ts/WorkerBase.ts"
			],
			"@WorldServer": [
				"../worldserver/ts/World/WorldServer.ts"
			],
		},
		"typeRoots": [
			"../world/ts/World.ts",
			"../world/ts/WorkerBase.ts",
			"../worldserver/ts/World/WorldServer.ts"
		],
	},
	"include": [
		"**/*.ts"
	]
}
