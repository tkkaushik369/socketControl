{
	"compilerOptions": {
		// "target": "ES2022",
		"target": "ES6",
		"module": "commonjs",
		"outDir": "../../dist/server",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": true,
		// "declarationMap": false,
		"declarationDir": "../../types/server",
		"paths": {
			"@WorldBase": [
				"../server/ts/World/WorldBase"
			],
		},
		"typeRoots": [
			"../server/ts/World/WorldBase"
		],
	},
	"include": [
		"**/*.ts"
	]
}
