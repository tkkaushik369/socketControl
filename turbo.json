{
	"$schema": "https://v2-9-18.turborepo.dev/schema.json",
	"tasks": {
		"build:world": {
			"inputs": ["src/world/**"],
			"outputs": ["dist/@World/**"]
		},
		"build:worldclient": {
			"inputs": ["src/worldclient/**"],
			"dependsOn": ["build:world"],
			"outputs": ["dist/@WorldClient/**"]
		},
		"build:worldserver": {
			"inputs": ["src/worldserver/**"],
			"dependsOn": ["build:world"],
			"outputs": ["dist/@WorldServer/**"]
		},
		"build:server": {
			"inputs": ["src/server/**"],
			"dependsOn": ["build:worldserver"],
			"outputs": ["dist/server/**"]
		},
		"build:client": {
			"inputs": ["src/client/**"],
			"dependsOn": ["build:worldclient"],
			"outputs": ["dist/client/**"]
		},
		"build:offline": {
			"inputs": [
				"src/electronApp/offline_window/**",
				"src/electronApp/commmon/**",
				"src/client/css/**",
				"src/LoaderMode.ts"
			],
			"dependsOn": ["build:worldclient"],
			"outputs": ["dist/offline/**"]
		},
		"build_struct": {
			"dependsOn": ["build:server", "build:client", "build:offline"],
			"outputs": []
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
