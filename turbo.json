{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build:world": {
			"inputs": ["src/**"],
			"outputs": ["dist/@World/**"]
		},
		"build:worldclient": {
			"inputs": ["src/**"],
			"dependsOn": ["build:world"],
			"outputs": ["dist/@WorldClient/**"]
		},
		"build:worldserver": {
			"inputs": ["src/**"],
			"dependsOn": ["build:world"],
			"outputs": ["dist/@WorldServer/**"]
		},
		"build:server": {
			"inputs": ["src/**"],
			"dependsOn": ["build:worldserver"],
			"outputs": ["dist/server/**"]
		},
		"build:client": {
			"inputs": ["src/**"],
			"dependsOn": ["build:worldclient"],
			"outputs": ["dist/client/**"]
		},
		"build:offline": {
			"inputs": ["src/**"],
			"dependsOn": ["build:world"],
			"outputs": ["dist/offline/**"]
		},
		"build_struct": {
			"dependsOn": ["build:server", "build:client", "build:offline"],
			"outputs": []
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
