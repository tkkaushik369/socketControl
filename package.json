		"xterm-addon-fit": "^0.8.0",
		"xterm-addon-search": "^0.13.0"
	},
	"dependencies": {
		"@types/jest": "^29.5.14",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"cannon-es": "^0.20.0",
		"electron-squirrel-startup": "^1.0.1",
		"express": "^4.21.1",
		"jsdom": "^25.0.1",
		"lodash": "^4.17.21",
		"nipplejs": "^0.10.2",
		"node-abi": "^4.15.0",
		"node-gyp": "^13.0.0",
		"park-miller": "^2.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.28.0",
		"socket.io": "^4.8.1",
		"socket.io-client": "^4.8.1",
		"socket.io-msgpack-parser": "^3.0.2",
		"three": "^0.185.1",
		"three-bvh-csg": "^0.0.17",
		"three-to-cannon": "^5.0.2",
		"turbo": "^2.10.0",
		"tweakpane": "^4.0.5",
		"ws": "^8.18.0"
	},
	"optionalDependencies": {
		"bufferutil": "^4.0.8",
		"utf-8-validate": "^5.0.10"
	},
	"overrides": {
		"extract-zip": "npm:@electron-internal/extract-zip@1.0.3"
	},
	"allowScripts": {
		"bufferutil@4.1.0": true,
		"utf-8-validate@5.0.10": true,
		"electron-winstaller@5.4.4": true
	}
}
