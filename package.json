{
	"name": "socketcontrol",
	"productName": "socketcontrol",
	"version": "1.0.0",
	"description": "Multiplayer Sketchbook",
	"main": ".webpack/main",
	"type": "commonjs",
	"scripts": {
		"setup": "npm install && npm fund && npm run build",
		"predeploy": "npm run build:world && npm run build:offline",
		"deploy": "gh-pages -d dist",
		"build:world": "webpack --config ./src/webpack.prod.world.ts",
		"build:worldclient": "webpack --config ./src/webpack.prod.worldclient.ts",
		"build:worldserver": "webpack --config ./src/webpack.prod.worldserver.ts",
		"build:client": "webpack --config ./src/webpack.prod.client.ts",
		"build:server": "webpack --config ./src/webpack.prod.server.ts",
		"build:offline": "webpack --config ./src/webpack.prod.offline.ts",
		"build:electron": "webpack --config ./src/ForgeConfig/webpack.full.electron.ts",
		"build:nw": "npm run build:world && npm run build:worldclient && npm run build:worldserver && npm run build:client && npm run build:server && npm run build:offline",
		"build:stats": "webpack --config ./src/webpack.prod.ts --profile --json > stats.json",
		"build:turbo": "turbo run build_struct",
		"build": "webpack --config ./src/webpack.prod.ts",
		"dev:world": "webpack serve --config ./src/webpack.dev.world.ts",
		"dev:worldclient": "webpack serve --config ./src/webpack.dev.worldclient.ts",
		"dev:worldserver": "webpack serve --config ./src/webpack.dev.worldserver.ts",
		"dev:client": "webpack serve --config ./src/webpack.dev.client.ts",
		"dev:server": "webpack serve --config ./src/webpack.dev.server.ts",
		"dev:offline": "webpack serve --config ./src/webpack.dev.offline.ts",
		"dev:na": "concurrently \"npm run dev:world\" \"npm run dev:worldclient\" \"npm run dev:worldserver\" \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:offline\"",
		"dev": "ts-node ./src/dev-logger.ts",
		"dev:server:start": "nodemon --watch ./dist ./app.js",
		"start:server": "node ./app.js",
		"fcm:na": "node forgeConfigMaker.ts",
		"start:na": "npm run fcm:na && electron-forge start",
		"start": "electron-forge start",
		"package:na": "npm run fcm:na && electron-forge package",
		"package": "electron-forge package",
		"make:na": "npm run fcm:na && electron-forge make",
		"make": "electron-forge make",
		"publish:na": "npm run fcm:na && electron-forge publish",
		"publish": "electron-forge publish",
		"lint": "eslint --ext .ts,.tsx .",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [],
	"homepage": "https://tkkaushik369.github.io/socketControl",
	"author": {
		"name": "tkkaushik369",
		"email": "krishnakaushiktiruveedula369@gmail.com"
	},
	"license": "MIT",
	"packageManager": "npm@8.5.0",
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@babel/preset-react": "^7.25.9",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-deb": "^7.11.2",
		"@electron-forge/maker-rpm": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
		"@electron-forge/plugin-fuses": "^7.11.2",
		"@electron-forge/plugin-webpack": "^7.11.2",
		"@electron-internal/extract-zip": "^1.0.3",
		"@electron/asar": "^3.2.17",
		"@electron/fuses": "^1.8.0",
		"@socket.io/admin-ui": "^0.5.1",
		"@tweakpane/core": "^2.0.4",
		"@types/debug": "^4.1.12",
		"@types/electron-squirrel-startup": "^1.0.2",
		"@types/express": "^4.17.21",
		"@types/express-ws": "^3.0.5",
		"@types/fs-extra": "^11.0.4",
		"@types/jsdom": "^21.1.7",
		"@types/lodash": "^4.17.10",
		"@types/node": "^22.9.0",
		"@types/three": "^0.185.1",
		"@types/webpack-dev-server": "^4.7.1",
		"@typescript-eslint/eslint-plugin": "^8.14.0",
		"@typescript-eslint/parser": "^8.14.0",
		"@vercel/webpack-asset-relocator-loader": "^1.7.3",
