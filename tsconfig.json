{
	"compilerOptions": {
		"jsx": "react-jsx",
		// "target": "ES2022",
		"target": "ES6",
		// "allowJs": true,
		"allowJs": false,
		// "module": "ES2020",
		"module": "CommonJS",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"baseUrl": ".",
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"paths": {
			"*": [
				"node_modules/*"
			],
			"@server/*": [
				"./src/server/*"
			],
			"@client/*": [
				"./src/client/*"
			],
			"@World": [
				"./src/world/ts/World.ts"
			],
			"@WorldClient": [
				"./src/worldclient/ts/World/WorldClient.ts"
			],
			"@WorldServer": [
				"./src/worldserver/ts/World/WorldServer.ts"
			],
		},
		"typeRoots": [
			"./src/server/*",
			"./src/client/*",
			"./src/world/ts/World.ts",
			"./src/worldclient/ts/World/WorldClient.ts",
			"./src/worldserver/ts/World/WorldServer.ts",
			"./node_modules/@types"
		],
	},
	"include": [
		"src/**/*"
	]
}
